{
  "name": "ultimate-football-27",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uf27-matches",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
